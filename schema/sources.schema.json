{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sources panel",
  "description": "Connection status and last sync per data source.",
  "type": "object",
  "required": [
    "sources"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "as_of"
      ],
      "properties": {
        "example_data": {
          "type": "boolean",
          "description": "true for the fictional data in this public repo. Real data must never be committed here."
        },
        "as_of": {
          "type": "string",
          "format": "date",
          "description": "Date used as 'today' for overdue math. Omit to use the viewer's current date."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "connected",
              "stale",
              "error",
              "not_connected"
            ]
          },
          "last_sync": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "feeds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}