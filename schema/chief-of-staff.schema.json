{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chief of Staff routing",
  "description": "Assignments with owner + deadline, at most 3 judgment calls, and a company-brain log.",
  "type": "object",
  "required": [
    "assignments",
    "judgment_calls"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "as_of"
      ],
      "properties": {
        "example_data": {
          "type": "boolean"
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "refresh": {
          "type": "string"
        },
        "run": {
          "type": "string"
        }
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "item",
          "owner",
          "deadline"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "deadline": {
            "type": "string",
            "format": "date"
          },
          "context": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "chasing",
              "done"
            ]
          }
        }
      }
    },
    "judgment_calls": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "brain_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "type",
          "text"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "enum": [
              "decision",
              "fact",
              "assumption",
              "gap"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}